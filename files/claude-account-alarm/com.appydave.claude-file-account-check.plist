<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed on the M2 2026-10-12 by David. Install = ~/.local/share/claude-account-alarm/ + this plist in ~/Library/LaunchAgents + launchctl bootstrap gui/$(id -u). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.appydave.claude-file-account-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/davidcruwys/.local/share/claude-account-alarm/claude-file-account-check.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>EXPECTED_EMAIL</key>
    <string>david@ideasmen.com.au</string>
    <key>CL_LOCAL_URL</key>
    <string>http://127.0.0.1:7101</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/davidcruwys/.local/state/claude-account-alarm/check.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/davidcruwys/.local/state/claude-account-alarm/check.log</string>
</dict>
</plist>
