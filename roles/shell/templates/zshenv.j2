# {{ ansible_managed }}
# =============================================================================
# .zshenv - Managed by Ansible
# Loads for ALL shell types: login, interactive, and non-interactive SSH
# =============================================================================
# WHY THIS FILE EXISTS:
# SSH non-login shells skip .zprofile, so Homebrew and nvm are invisible
# to plain `ssh host "command"` calls. Putting them here fixes that.
# This is what makes `ssh mac-mini-m2 "claude --version"` work.
# =============================================================================

# Homebrew (Apple Silicon)
eval "$(/opt/homebrew/bin/brew shellenv)"

# nvm (Node version manager) — claude binary lives here
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
# Put nvm's default node FIRST. Sourcing nvm.sh never reorders a PATH that already holds
# its bin dir (inherited from a parent shell), so Homebrew's own node (a gemini-cli
# dependency) kept winning in `zsh -c` children such as overmind/tmux panes (2026-11-03).
# No-op when the default alias is not a plain version (e.g. "node", "lts/*").
if [ -s "$NVM_DIR/alias/default" ]; then
  _nvm_bin="$NVM_DIR/versions/node/v$(sed 's/^v//' "$NVM_DIR/alias/default")/bin"
  [ -d "$_nvm_bin" ] && path=("$_nvm_bin" ${path:#$_nvm_bin})
  unset _nvm_bin
fi

# Rust / cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# David's own tools (~/bin: kfind, my-app) and bun, for every shell, including ssh and `zsh -lc` launches (2026-11-08)
[ -d "$HOME/.bun/bin" ] && path=("$HOME/.bun/bin" ${path:#$HOME/.bun/bin})
[ -d "$HOME/bin" ] && path=("$HOME/bin" ${path:#$HOME/bin})

# Machine-specific secrets (API keys, etc.)
[ -f "$HOME/.config/appydave/.env.secrets" ] && set -a && . "$HOME/.config/appydave/.env.secrets" && set +a

# Claude Code headless auth — SSH / headless shells ONLY (token file is 0600).
# A local terminal must use the keychain login instead: this setup-token is
# inference-only, and Claude in Chrome refuses to load under it (debug log:
# "[Claude in Chrome] Disabled: OAuth token has no scope…"). Scoped 2026-09-22.
if [[ -n "$SSH_CONNECTION" || -z "$TERM_PROGRAM" ]]; then
  [ -f ~/.config/claude/token.sh ] && source ~/.config/claude/token.sh
fi
