# {{ ansible_managed }}
# =============================================================================
# .zshrc - Managed by Ansible
# Hand fixes go in this template first, then apply; never edit one Mac's ~/.zshrc alone.
# =============================================================================

# Path to Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="{{ zsh_theme }}"

# Plugins
plugins=(
{% for plugin in zsh_plugins %}
  {{ plugin }}
{% endfor %}
)

# oh-my-zsh: update without asking. The [Y/n] update prompt ate the first key of agent launches ('claude' -> 'laude: not found', 2026-09-20).
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 13

source $ZSH/oh-my-zsh.sh

# -----------------------------------------------------------------------------
# Version managers
# -----------------------------------------------------------------------------
# rbenv
eval "$(rbenv init -)"

# pyenv
eval "$(pyenv init - --no-rehash)"  # --no-rehash: a stale shim lock stalled every new shell 60s (11 Nov 2026). pip installs still rehash on their own (pyenv's pip-rehash hook).

# -----------------------------------------------------------------------------
# PATH
# -----------------------------------------------------------------------------
{% for p in shell_extra_paths %}
export PATH="{{ p }}:$PATH"
{% endfor %}

{% if rust_toolchain | length > 0 %}
# Rust (installed via rustup)
export PATH="$HOME/.cargo/bin:$PATH"
# Homebrew's rustup keeps the cargo/rustc shims in its opt dir; only `rustup` itself is linked into /opt/homebrew/bin.
[ -d /opt/homebrew/opt/rustup/bin ] && export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
{% endif %}

{% if enable_postgresql_paths | default(false) %}
# PostgreSQL client tools (libpq — installed via postgresql@17)
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
{% endif %}

# User scripts
export PATH="$PATH:$HOME/scripts"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# nvm — loaded AFTER every PATH prepend above, so nvm's node wins over Homebrew's.
# Homebrew installs its own node as a dependency (e.g. gemini-cli); loaded first, nvm
# lost and Captain's Log ran on node 25, where its client tests fail (2026-11-03).
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
# Put nvm's default node FIRST. Sourcing nvm.sh never reorders a PATH that already holds
# its bin dir (inherited from a parent shell), so Homebrew's own node (a gemini-cli
# dependency) kept winning in `zsh -c` children such as overmind/tmux panes (2026-11-03).
# No-op when the default alias is not a plain version (e.g. "node", "lts/*").
if [ -s "$NVM_DIR/alias/default" ]; then
  _nvm_bin="$NVM_DIR/versions/node/v$(sed 's/^v//' "$NVM_DIR/alias/default")/bin"
  [ -d "$_nvm_bin" ] && path=("$_nvm_bin" ${path:#$_nvm_bin})
  unset _nvm_bin
fi

# -----------------------------------------------------------------------------
# Environment variables
# -----------------------------------------------------------------------------
{# shell_env_vars_host (host_vars) adds to or overrides the group values, one export per key #}
{% for key, value in (shell_env_vars | combine(shell_env_vars_host)).items() %}
export {{ key }}="{{ value }}"
{% endfor %}

{% if enable_postgresql_paths | default(false) %}
# Compiler flags for PostgreSQL (needed for native gem/package builds against libpq)
export LDFLAGS="-L/opt/homebrew/opt/libpq/lib"
export CPPFLAGS="-I/opt/homebrew/opt/libpq/include"
{% endif %}

# -----------------------------------------------------------------------------
# Secrets (API keys, tokens - never committed to version control)
# -----------------------------------------------------------------------------
[ -f "$HOME/.secrets" ] && source "$HOME/.secrets"

# -----------------------------------------------------------------------------
# Custom user configuration (not managed by Ansible)
# -----------------------------------------------------------------------------
# Add your personal aliases, functions, and customizations to ~/.zshrc.local
# This file is sourced last and will override any Ansible-managed settings
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
{% if shell_buzz_wrapper | default(false) %}

# Buzz relay: the wrapper loads ~/.buzz-env.sh in a subshell, so the relay key never sits in the
# interactive environment for every child process to read. Agents (BUZZ_AGENT set) never load it.
buzz() { ( [ -z "$BUZZ_AGENT" ] && source "$HOME/.buzz-env.sh" 2>/dev/null; command buzz "$@" ); }
# Load the relay env into THIS shell on purpose (the bridge needs it; the wrapper above does not cover it).
buzzenv() {
  source "$HOME/.buzz-env.sh" 2>/dev/null \
    && echo "buzz env loaded -> ${BUZZ_RELAY_URL:-unset}" \
    || echo "no ~/.buzz-env.sh"
}
{% endif %}
{% set _rc_sources = (shell_rc_sources | default([])) + (shell_rc_sources_host | default([])) %}
{% if _rc_sources | length > 0 %}

# Extra shell files sourced if present (list lives in the private inventory, not this public repo)
{% for s in _rc_sources %}
[ -f "{{ s }}" ] && source "{{ s }}"
{% endfor %}
{% endif %}
